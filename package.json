{
  "name": "cx-attachments-migrationapp",
  "version": "1.0.0",
  "description": "SAP CAP application to migrate SAP C4C account attachments to a configurable target endpoint, with a Fiori elements UI.",
  "dependencies": {
    "@sap/cds": "^9",
    "@cap-js/hana": "^2",
    "@sap/xssec": "^4",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "archiver": "^7",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "cds": {
    "requires": {
      "auth": {
        "[development]": { "kind": "dummy" },
        "[hybrid]": { "kind": "dummy" },
        "[production]": { "kind": "xsuaa" }
      },
      "db": {
        "[development]": { "kind": "sqlite", "credentials": { "url": ":memory:" } },
        "[production]": { "kind": "hana-cloud" }
      },
      "C4C_ODATA": {
        "kind": "odata-v2",
        "model": "srv/external/C4C_ODATA",
        "csrf": true,
        "csrfInBatch": true,
        "[development]": {
          "credentials": { "url": "https://my332854.crm.ondemand.com/sap/c4c/odata/v1/c4codataapi" }
        },
        "[hybrid]": {
          "credentials": { "destination": "C4C_PROD_HARDCODED", "path": "/sap/c4c/odata/v1/c4codataapi" }
        },
        "[production]": {
          "credentials": { "destination": "C4C_PROD_HARDCODED", "path": "/sap/c4c/odata/v1/c4codataapi" }
        }
      },
      "TARGET_ENDPOINT": {
        "kind": "rest",
        "[production]": {
          "credentials": { "destination": "MIGRATION_TARGET" }
        }
      }
    }
  },
  "sapux": [
    "app/migration",
    "app/jobs",
    "app/queries"
  ],
  "private": true
}
